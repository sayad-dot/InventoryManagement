# Azure Deployment Environment Variables Template
# DO NOT commit actual values to Git!

# PostgreSQL Database Configuration
POSTGRES_ADMIN_PASSWORD=<your-strong-password-here>

# Google OAuth Configuration
AUTHENTICATION__GOOGLE__CLIENTID=<your-google-client-id>
AUTHENTICATION__GOOGLE__CLIENTSECRET=<your-google-client-secret>

# Facebook OAuth Configuration (Optional)
AUTHENTICATION__FACEBOOK__APPID=<your-facebook-app-id>
AUTHENTICATION__FACEBOOK__APPSECRET=<your-facebook-app-secret>

# Azure Deployment
AZURE_LOCATION=eastus
AZURE_ENV_NAME=production
