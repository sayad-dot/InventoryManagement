@model InventoryManagement.ViewModels.EditInventoryViewModel
@{
    ViewData["Title"] = "Inventory Settings - " + Model.Title;
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h4 class="card-title mb-0">Inventory Settings - @Model.Title</h4>
                    <div>
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-light btn-sm">Back to Inventory</a>
                    </div>
                </div>
                
                <!-- Tabs -->
                <ul class="nav nav-tabs" id="settingsTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="basic-tab" data-bs-toggle="tab" data-bs-target="#basic" type="button" role="tab">
                            Basic Info
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="customid-tab" data-bs-toggle="tab" data-bs-target="#customid" type="button" role="tab">
                            Custom ID
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="fields-tab" data-bs-toggle="tab" data-bs-target="#fields" type="button" role="tab">
                            Custom Fields
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="access-tab" data-bs-toggle="tab" data-bs-target="#access" type="button" role="tab">
                            Access Control
                        </button>
                    </li>
                </ul>

                <div class="tab-content" id="settingsTabsContent">
                    <!-- Basic Info Tab -->
                    <div class="tab-pane fade show active" id="basic" role="tabpanel">
                        <div class="card-body">
                            @if (TempData["SuccessMessage"] != null)
                            {
                                <div class="alert alert-success alert-dismissible fade show" role="alert">
                                    @TempData["SuccessMessage"]
                                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                                </div>
                            }

                            <form method="post" asp-action="UpdateBasicSettings">
                                <input type="hidden" asp-for="Id" />
                                
                                <div class="mb-3">
                                    <label asp-for="Title" class="form-label"></label>
                                    <input asp-for="Title" class="form-control" />
                                    <span asp-validation-for="Title" class="text-danger"></span>
                                </div>
                                
                                <div class="mb-3">
                                    <label asp-for="Description" class="form-label">
                                        Description
                                        <small class="text-muted">(Supports Markdown formatting)</small>
                                    </label>
                                    <textarea asp-for="Description" class="form-control markdown-editor" rows="10" id="descriptionEditor"></textarea>
                                    <span asp-validation-for="Description" class="text-danger"></span>
                                    <small class="form-text text-muted">
                                        <i class="fas fa-info-circle"></i>
                                        You can use <strong>Markdown</strong> for formatting: **bold**, *italic*, [links](url), lists, and more!
                                    </small>
                                </div>
                                
                                <div class="mb-3">
                                    <label asp-for="CategoryId" class="form-label"></label>
                                    <select asp-for="CategoryId" class="form-select" asp-items="@(new SelectList(Model.AvailableCategories, "Id", "Name"))">
                                        <option value="">Select a category</option>
                                    </select>
                                </div>
                                
                                <div class="mb-3">
                                    <label asp-for="ImageUrl" class="form-label"></label>
                                    <input asp-for="ImageUrl" class="form-control" placeholder="https://example.com/image.jpg" />
                                    <div class="form-text">
                                        <strong>⚠️ Note:</strong> Google Images URLs often don't work due to CORS restrictions. 
                                        Try <a href="https://unsplash.com" target="_blank">Unsplash</a>, 
                                        <a href="https://pixabay.com" target="_blank">Pixabay</a>, or 
                                        <a asp-action="TestImage" target="_blank">test your URL first</a>.
                                    </div>
                                    <span asp-validation-for="ImageUrl" class="text-danger"></span>
                                </div>
                                
                                <div class="mb-3 form-check">
                                    <input asp-for="IsPublic" class="form-check-input" />
                                    <label asp-for="IsPublic" class="form-check-label">Make this inventory public (all authenticated users can add items)</label>
                                </div>
                                
                                <button type="submit" class="btn btn-primary">Save Changes</button>
                            </form>
                        </div>
                    </div>

                    <!-- Custom ID Tab -->
                    <div class="tab-pane fade" id="customid" role="tabpanel">
                        <div class="card-body">
                            <div class="mb-4">
                                <h5><i class="fas fa-fingerprint me-2"></i>Custom ID Format Configuration</h5>
                                <p class="text-muted">
                                    Define how item IDs are automatically generated for this inventory. 
                                    Build your ID format by adding elements and arranging them in your desired order.
                                </p>
                                <div class="alert alert-info">
                                    <i class="fas fa-info-circle me-1"></i>
                                    <strong>Note:</strong> Each item will have a globally unique internal ID (hidden from UI) and a custom ID unique to this inventory.
                                </div>
                            </div>

                            <form method="post" asp-action="UpdateCustomIdFormat" id="customIdForm">
                                <input type="hidden" asp-for="Id" />
                                <input type="hidden" id="customIdFormatJson" name="customIdFormatJson" value="" />

                                <!-- Element Type Selection -->
                                <div class="card mb-3 border-primary">
                                    <div class="card-header bg-primary text-white">
                                        <h6 class="mb-0"><i class="fas fa-plus-circle me-2"></i>Add ID Elements</h6>
                                    </div>
                                    <div class="card-body">
                                        <div class="row g-2">
                                            <div class="col-md-3">
                                                <button type="button" class="btn btn-outline-primary w-100 add-element" data-type="fixed">
                                                    <i class="fas fa-font"></i> Fixed Text
                                                </button>
                                            </div>
                                            <div class="col-md-3">
                                                <button type="button" class="btn btn-outline-primary w-100 add-element" data-type="random20">
                                                    <i class="fas fa-dice"></i> 20-bit Random
                                                </button>
                                            </div>
                                            <div class="col-md-3">
                                                <button type="button" class="btn btn-outline-primary w-100 add-element" data-type="random32">
                                                    <i class="fas fa-dice-d20"></i> 32-bit Random
                                                </button>
                                            </div>
                                            <div class="col-md-3">
                                                <button type="button" class="btn btn-outline-primary w-100 add-element" data-type="random6">
                                                    <i class="fas fa-hashtag"></i> 6-digit Random
                                                </button>
                                            </div>
                                            <div class="col-md-3">
                                                <button type="button" class="btn btn-outline-primary w-100 add-element" data-type="random9">
                                                    <i class="fas fa-hashtag"></i> 9-digit Random
                                                </button>
                                            </div>
                                            <div class="col-md-3">
                                                <button type="button" class="btn btn-outline-primary w-100 add-element" data-type="guid">
                                                    <i class="fas fa-key"></i> GUID
                                                </button>
                                            </div>
                                            <div class="col-md-3">
                                                <button type="button" class="btn btn-outline-primary w-100 add-element" data-type="datetime">
                                                    <i class="fas fa-calendar"></i> Date/Time
                                                </button>
                                            </div>
                                            <div class="col-md-3">
                                                <button type="button" class="btn btn-outline-primary w-100 add-element" data-type="sequence">
                                                    <i class="fas fa-sort-numeric-up"></i> Sequence
                                                </button>
                                            </div>
                                        </div>
                                        <div class="mt-3">
                                            <label class="form-label">Separator Character</label>
                                            <input type="text" id="separator" class="form-control" value="-" maxlength="3" placeholder="-">
                                            <small class="text-muted">Character(s) between ID elements (e.g., "-", "_", "")</small>
                                        </div>
                                    </div>
                                </div>

                                <!-- ID Elements Container (Drag & Drop) -->
                                <div class="card mb-3">
                                    <div class="card-header bg-light">
                                        <h6 class="mb-0"><i class="fas fa-list me-2"></i>ID Format Structure (Drag to reorder)</h6>
                                    </div>
                                    <div class="card-body">
                                        <div id="idElementsContainer" class="sortable-container">
                                            <!-- Elements will be added here dynamically -->
                                            <div class="text-muted text-center py-4" id="emptyMessage">
                                                <i class="fas fa-arrow-up fa-2x mb-2"></i>
                                                <p>Click buttons above to add ID elements</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Preview -->
                                <div class="card mb-3 border-success">
                                    <div class="card-header bg-success text-white">
                                        <h6 class="mb-0"><i class="fas fa-eye me-2"></i>Preview</h6>
                                    </div>
                                    <div class="card-body">
                                        <div class="alert alert-light border mb-0">
                                            <strong>Example ID:</strong> 
                                            <span id="previewText" class="ms-2 font-monospace fs-5 text-primary">-</span>
                                        </div>
                                    </div>
                                </div>

                                <div class="d-flex gap-2">
                                    <button type="submit" class="btn btn-primary">
                                        <i class="fas fa-save me-1"></i>Save ID Format
                                    </button>
                                    <button type="button" class="btn btn-outline-secondary" id="clearFormat">
                                        <i class="fas fa-trash me-1"></i>Clear All
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>

                    <!-- Custom Fields Tab -->
                    <div class="tab-pane fade" id="fields" role="tabpanel">
                        <div class="card-body">
                            <div class="mb-4">
                                <h5>Manage Custom Fields</h5>
                                <p class="text-muted">Define the data fields for items in this inventory. You can have up to 3 fields of each type.</p>
                            </div>

                            <form method="post" asp-action="UpdateCustomFields" id="customFieldsForm">
                                <input type="hidden" asp-for="Id" />
                                <input type="hidden" id="FieldOrder" name="FieldOrder" value="@Model.FieldOrder" />

                                <div id="customFieldsContainer">
                                    @foreach (var field in Model.CustomFields)
                                    {
                                        <div class="card mb-3 field-item" data-field-type="@field.Type" data-field-index="@field.Index">
                                            <div class="card-header d-flex justify-content-between align-items-center">
                                                <div>
                                                    <i class="fas @GetFieldTypeIcon(field.Type) me-2"></i>
                                                    <strong>@GetFieldTypeDisplayName(field.Type) Field @field.Index</strong>
                                                </div>
                                                <div>
                                                    <button type="button" class="btn btn-sm btn-outline-secondary me-1 move-up">
                                                        <i class="fas fa-arrow-up"></i>
                                                    </button>
                                                    <button type="button" class="btn btn-sm btn-outline-secondary me-1 move-down">
                                                        <i class="fas fa-arrow-down"></i>
                                                    </button>
                                                    <div class="form-check form-switch d-inline-block me-2">
                                                        <input class="form-check-input field-active" type="checkbox" 
                                                               name="CustomFields[@GetFieldIndex(field.Type, field.Index)].IsActive" 
                                                               value="true" @(field.IsActive ? "checked" : "")>
                                                        <input type="hidden" name="CustomFields[@GetFieldIndex(field.Type, field.Index)].IsActive" value="false">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="card-body">
                                                <div class="row">
                                                    <div class="col-md-8">
                                                        <div class="mb-3">
                                                            <label class="form-label">Field Name</label>
                                                            <input type="text" class="form-control field-name" 
                                                                   name="CustomFields[@GetFieldIndex(field.Type, field.Index)].Name" 
                                                                   value="@field.Name" 
                                                                   placeholder="Enter field name (e.g., 'Model', 'Price')">
                                                        </div>
                                                    </div>
                                                    <div class="col-md-4">
                                                        <div class="mb-3">
                                                            <label class="form-label">Field Type</label>
                                                            <input type="text" class="form-control" value="@GetFieldTypeDisplayName(field.Type)" readonly>
                                                            <input type="hidden" name="CustomFields[@GetFieldIndex(field.Type, field.Index)].Type" value="@field.Type">
                                                            <input type="hidden" name="CustomFields[@GetFieldIndex(field.Type, field.Index)].Index" value="@field.Index">
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>

                                <button type="submit" class="btn btn-primary">Save Field Configuration</button>
                            </form>
                        </div>
                    </div>

                    <!-- Access Control Tab -->
                    <div class="tab-pane fade" id="access" role="tabpanel">
                        <div class="card-body">
                            <h5>Access Control</h5>
                            <p class="text-muted">Manage who can add items to this inventory.</p>
                            
                            <div class="d-grid gap-2">
                                <a asp-action="AccessControl" asp-route-id="@Model.Id" class="btn btn-outline-info">
                                    <i class="fas fa-users-cog me-1"></i>Manage Access Control
                                </a>
                            </div>
                            
                            <div class="mt-3">
                                <small class="text-muted">
                                    <i class="fas fa-info-circle me-1"></i>
                                    Configure public/private settings and manage user-specific access permissions.
                                </small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    
    <!-- Markdown Editor Initialization -->
    <script>
        // ============================================
        // MARKDOWN EDITOR SETUP
        // ============================================
        let markdownEditor;
        
        document.addEventListener('DOMContentLoaded', function() {
            const descriptionTextarea = document.getElementById('descriptionEditor');
            
            if (descriptionTextarea) {
                // Initialize EasyMDE
                markdownEditor = new EasyMDE({
                    element: descriptionTextarea,
                    spellChecker: false,
                    autosave: {
                        enabled: false // We handle auto-save separately
                    },
                    placeholder: "Enter inventory description using Markdown formatting...",
                    status: ["lines", "words", "cursor"],
                    toolbar: [
                        "bold", "italic", "heading", "|",
                        "quote", "unordered-list", "ordered-list", "|",
                        "link", "image", "|",
                        "preview", "side-by-side", "fullscreen", "|",
                        "guide"
                    ],
                    previewRender: function(plainText) {
                        // Use marked.js to render markdown with DOMPurify for security
                        const rawHtml = marked.parse(plainText);
                        return DOMPurify.sanitize(rawHtml);
                    },
                    renderingConfig: {
                        singleLineBreaks: false,
                        codeSyntaxHighlighting: true,
                    }
                });

                // Apply theme to editor
                applyEditorTheme();
                
                // Listen for theme changes
                const themeObserver = new MutationObserver(function(mutations) {
                    mutations.forEach(function(mutation) {
                        if (mutation.attributeName === 'data-theme') {
                            applyEditorTheme();
                        }
                    });
                });
                
                themeObserver.observe(document.documentElement, {
                    attributes: true,
                    attributeFilter: ['data-theme']
                });
            }
        });

        function applyEditorTheme() {
            const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
            const editorContainer = document.querySelector('.EasyMDEContainer');
            
            if (editorContainer) {
                if (isDark) {
                    editorContainer.classList.add('dark-theme');
                } else {
                    editorContainer.classList.remove('dark-theme');
                }
            }
        }
    </script>

    <!-- Markdown Editor Dark Mode Styling -->
    <style>
        .EasyMDEContainer.dark-theme .CodeMirror {
            background-color: #1e1e1e;
            color: #e9ecef;
            border-color: #495057;
        }

        .EasyMDEContainer.dark-theme .CodeMirror-cursor {
            border-left-color: #e9ecef;
        }

        .EasyMDEContainer.dark-theme .editor-toolbar {
            background-color: #2d2d2d;
            border-color: #495057;
        }

        .EasyMDEContainer.dark-theme .editor-toolbar button {
            color: #e9ecef !important;
        }

        .EasyMDEContainer.dark-theme .editor-toolbar button:hover,
        .EasyMDEContainer.dark-theme .editor-toolbar button.active {
            background-color: #495057;
            border-color: #6c757d;
        }

        .EasyMDEContainer.dark-theme .editor-toolbar i.separator {
            border-left-color: #495057;
            border-right-color: #495057;
        }

        .EasyMDEContainer.dark-theme .editor-statusbar {
            background-color: #2d2d2d;
            color: #adb5bd;
            border-color: #495057;
        }

        .EasyMDEContainer.dark-theme .editor-preview,
        .EasyMDEContainer.dark-theme .editor-preview-side {
            background-color: #1e1e1e;
            color: #e9ecef;
        }

        .EasyMDEContainer.dark-theme .editor-preview h1,
        .EasyMDEContainer.dark-theme .editor-preview h2,
        .EasyMDEContainer.dark-theme .editor-preview h3,
        .EasyMDEContainer.dark-theme .editor-preview h4,
        .EasyMDEContainer.dark-theme .editor-preview h5,
        .EasyMDEContainer.dark-theme .editor-preview h6,
        .EasyMDEContainer.dark-theme .editor-preview-side h1,
        .EasyMDEContainer.dark-theme .editor-preview-side h2,
        .EasyMDEContainer.dark-theme .editor-preview-side h3,
        .EasyMDEContainer.dark-theme .editor-preview-side h4,
        .EasyMDEContainer.dark-theme .editor-preview-side h5,
        .EasyMDEContainer.dark-theme .editor-preview-side h6 {
            color: #e9ecef;
        }

        .EasyMDEContainer.dark-theme .CodeMirror-selected {
            background-color: #495057;
        }

        /* Make editor fit nicely */
        .EasyMDEContainer .CodeMirror {
            min-height: 200px;
        }
    </style>
    
    <!-- Auto-save functionality for Basic Info tab -->
    <script>
        // ============================================
        // AUTO-SAVE FUNCTIONALITY
        // ============================================
        document.addEventListener('DOMContentLoaded', function() {
            const basicInfoForm = document.querySelector('#basic form');
            if (!basicInfoForm) return;

            let hasChanges = false;
            let autoSaveTimer = null;
            let currentVersion = '@Convert.ToBase64String(Model.Version ?? Array.Empty<byte>())';
            let isSaving = false;

            // Create status indicator
            const statusIndicator = document.createElement('div');
            statusIndicator.id = 'autoSaveStatus';
            statusIndicator.className = 'auto-save-status';
            statusIndicator.innerHTML = '<i class="fas fa-circle"></i> <span class="status-text">Ready</span>';
            basicInfoForm.querySelector('.btn-primary').insertAdjacentElement('beforebegin', statusIndicator);

            // Track changes in form fields - UPDATED to use markdown editor
            const formFields = basicInfoForm.querySelectorAll('input[name="Title"], select[name="CategoryId"], input[name="ImageUrl"], input[name="IsPublic"]');
            
            formFields.forEach(field => {
                field.addEventListener('input', function() {
                    if (!hasChanges) {
                        hasChanges = true;
                        showStatus('pending', 'Unsaved changes');
                    }
                    resetAutoSaveTimer();
                });
                
                field.addEventListener('change', function() {
                    if (!hasChanges) {
                        hasChanges = true;
                        showStatus('pending', 'Unsaved changes');
                    }
                    resetAutoSaveTimer();
                });
            });

            // Track markdown editor changes
            if (typeof markdownEditor !== 'undefined' && markdownEditor) {
                markdownEditor.codemirror.on('change', function() {
                    if (!hasChanges) {
                        hasChanges = true;
                        showStatus('pending', 'Unsaved changes');
                    }
                    resetAutoSaveTimer();
                });
            }

            function resetAutoSaveTimer() {
                if (autoSaveTimer) {
                    clearTimeout(autoSaveTimer);
                }
                // Auto-save after 8 seconds of inactivity (between 7-10 seconds as required)
                autoSaveTimer = setTimeout(autoSave, 8000);
            }

            async function autoSave() {
                if (!hasChanges || isSaving) return;

                isSaving = true;
                showStatus('saving', 'Saving...');

                const formData = {
                    Id: parseInt(basicInfoForm.querySelector('input[name="Id"]').value),
                    Title: basicInfoForm.querySelector('input[name="Title"]').value,
                    Description: markdownEditor ? markdownEditor.value() : basicInfoForm.querySelector('textarea[name="Description"]').value,
                    CategoryId: basicInfoForm.querySelector('select[name="CategoryId"]').value || null,
                    ImageUrl: basicInfoForm.querySelector('input[name="ImageUrl"]').value,
                    IsPublic: basicInfoForm.querySelector('input[name="IsPublic"]').checked,
                    Version: currentVersion ? Array.from(atob(currentVersion)).map(c => c.charCodeAt(0)) : null
                };

                try {
                    const response = await fetch('@Url.Action("AutoSaveBasicSettings", "Inventory")', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify(formData)
                    });

                    const result = await response.json();

                    if (result.success) {
                        hasChanges = false;
                        currentVersion = result.version;
                        showStatus('saved', 'Saved');
                        
                        // Clear status after 3 seconds
                        setTimeout(() => {
                            if (!hasChanges) {
                                showStatus('ready', 'Ready');
                            }
                        }, 3000);
                    } else if (result.conflict) {
                        showStatus('error', 'Conflict! Refresh needed');
                        alert(result.message);
                        location.reload();
                    } else {
                        showStatus('error', 'Save failed');
                        console.error('Auto-save error:', result.message);
                    }
                } catch (error) {
                    showStatus('error', 'Save failed');
                    console.error('Auto-save error:', error);
                } finally {
                    isSaving = false;
                }
            }

            function showStatus(status, text) {
                const indicator = document.getElementById('autoSaveStatus');
                if (!indicator) return;

                indicator.className = 'auto-save-status status-' + status;
                indicator.querySelector('.status-text').textContent = text;

                const icon = indicator.querySelector('i');
                icon.className = status === 'saving' ? 'fas fa-spinner fa-spin' :
                                status === 'saved' ? 'fas fa-check-circle' :
                                status === 'error' ? 'fas fa-exclamation-circle' :
                                status === 'pending' ? 'fas fa-circle' :
                                'fas fa-circle';
            }

            // Manual save still works
            basicInfoForm.addEventListener('submit', function(e) {
                if (autoSaveTimer) {
                    clearTimeout(autoSaveTimer);
                }
                hasChanges = false;
            });

            // Save before leaving if there are changes
            window.addEventListener('beforeunload', function(e) {
                if (hasChanges && !isSaving) {
                    e.preventDefault();
                    e.returnValue = 'You have unsaved changes. Are you sure you want to leave?';
                    return e.returnValue;
                }
            });
        });
    </script>

    <!-- Auto-save styling -->
    <style>
        .auto-save-status {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.375rem 0.75rem;
            border-radius: 0.375rem;
            font-size: 0.875rem;
            margin-right: 1rem;
            transition: all 0.3s ease;
        }

        .auto-save-status.status-ready {
            color: #6c757d;
            background-color: #f8f9fa;
        }

        .auto-save-status.status-pending {
            color: #856404;
            background-color: #fff3cd;
            border: 1px solid #ffc107;
        }

        .auto-save-status.status-saving {
            color: #0c5460;
            background-color: #d1ecf1;
            border: 1px solid #17a2b8;
        }

        .auto-save-status.status-saved {
            color: #155724;
            background-color: #d4edda;
            border: 1px solid #28a745;
        }

        .auto-save-status.status-error {
            color: #721c24;
            background-color: #f8d7da;
            border: 1px solid #dc3545;
        }

        [data-theme="dark"] .auto-save-status.status-ready {
            color: #adb5bd;
            background-color: #2d2d2d;
        }

        [data-theme="dark"] .auto-save-status.status-pending {
            color: #ffc107;
            background-color: rgba(255, 193, 7, 0.15);
        }

        [data-theme="dark"] .auto-save-status.status-saving {
            color: #17a2b8;
            background-color: rgba(23, 162, 184, 0.15);
        }

        [data-theme="dark"] .auto-save-status.status-saved {
            color: #28a745;
            background-color: rgba(40, 167, 69, 0.15);
        }

        [data-theme="dark"] .auto-save-status.status-error {
            color: #dc3545;
            background-color: rgba(220, 53, 69, 0.15);
        }
    </style>

    <script>
        // Field management JavaScript
        document.addEventListener('DOMContentLoaded', function() {
            // Move field up
            document.querySelectorAll('.move-up').forEach(button => {
                button.addEventListener('click', function() {
                    const card = this.closest('.field-item');
                    const prevCard = card.previousElementSibling;
                    if (prevCard) {
                        card.parentNode.insertBefore(card, prevCard);
                        updateFieldOrder();
                    }
                });
            });

            // Move field down
            document.querySelectorAll('.move-down').forEach(button => {
                button.addEventListener('click', function() {
                    const card = this.closest('.field-item');
                    const nextCard = card.nextElementSibling;
                    if (nextCard) {
                        card.parentNode.insertBefore(nextCard, card);
                        updateFieldOrder();
                    }
                });
            });

            function updateFieldOrder() {
                const fields = document.querySelectorAll('.field-item');
                const order = Array.from(fields).map(field => {
                    const type = field.getAttribute('data-field-type');
                    const index = field.getAttribute('data-field-index');
                    return `${type}_${index}`;
                });
                document.getElementById('FieldOrder').value = order.join(',');
            }

            // Initialize field order
            updateFieldOrder();
        });

        // ============================================
        // Custom ID Format Management
        // ============================================
        let idElements = [];
        let elementCounter = 0;

        // Element type metadata
        const elementTypes = {
            'fixed': { name: 'Fixed Text', icon: 'fa-font', color: 'primary', preview: 'TEXT' },
            'random20': { name: '20-bit Random', icon: 'fa-dice', color: 'info', preview: 'A1B2C' },
            'random32': { name: '32-bit Random', icon: 'fa-dice-d20', color: 'info', preview: 'E74FA329' },
            'random6': { name: '6-digit Random', icon: 'fa-hashtag', color: 'warning', preview: '123456' },
            'random9': { name: '9-digit Random', icon: 'fa-hashtag', color: 'warning', preview: '987654321' },
            'guid': { name: 'GUID', icon: 'fa-key', color: 'secondary', preview: 'A1B2C3D4...' },
            'datetime': { name: 'Date/Time', icon: 'fa-calendar', color: 'success', preview: '20251102' },
            'sequence': { name: 'Sequence', icon: 'fa-sort-numeric-up', color: 'danger', preview: '001' }
        };

        // Load existing format if any
        const existingFormat = '@Html.Raw(Model.CustomIdFormat ?? "")';
        if (existingFormat) {
            try {
                const config = JSON.parse(existingFormat);
                if (config.elements && Array.isArray(config.elements)) {
                    idElements = config.elements;
                    document.getElementById('separator').value = config.separator || '-';
                    renderElements();
                }
            } catch (e) {
                console.error('Error parsing existing format:', e);
            }
        }

        // Add element button handlers
        document.querySelectorAll('.add-element').forEach(button => {
            button.addEventListener('click', function() {
                const type = this.getAttribute('data-type');
                addElement(type);
            });
        });

        // Clear format button
        document.getElementById('clearFormat')?.addEventListener('click', function() {
            if (confirm('Are you sure you want to clear the entire ID format?')) {
                idElements = [];
                elementCounter = 0;
                renderElements();
                updatePreview();
            }
        });

        // Separator change handler
        document.getElementById('separator')?.addEventListener('input', function() {
            updatePreview();
        });

        // Form submit handler
        document.getElementById('customIdForm')?.addEventListener('submit', function(e) {
            const config = {
                elements: idElements,
                separator: document.getElementById('separator').value || '-'
            };
            document.getElementById('customIdFormatJson').value = JSON.stringify(config);
        });

        // Add a new element
        function addElement(type) {
            const element = {
                type: type,
                value: type === 'fixed' ? 'TEXT' : (type === 'datetime' ? 'yyyyMMdd' : ''),
                order: idElements.length,
                options: type === 'sequence' ? JSON.stringify({ leadingZeros: 3 }) : null,
                id: ++elementCounter
            };
            idElements.push(element);
            renderElements();
            updatePreview();
        }

        // Remove element
        function removeElement(id) {
            idElements = idElements.filter(e => e.id !== id);
            // Reorder remaining elements
            idElements.forEach((el, idx) => el.order = idx);
            renderElements();
            updatePreview();
        }

        // Update element value
        function updateElementValue(id, value) {
            const element = idElements.find(e => e.id === id);
            if (element) {
                element.value = value;
                updatePreview();
            }
        }

        // Render all elements
        function renderElements() {
            const container = document.getElementById('idElementsContainer');
            const emptyMessage = document.getElementById('emptyMessage');
            
            if (idElements.length === 0) {
                emptyMessage.style.display = 'block';
                container.innerHTML = '';
                container.appendChild(emptyMessage);
                return;
            }

            emptyMessage.style.display = 'none';
            container.innerHTML = '';
            
            idElements.sort((a, b) => a.order - b.order).forEach(element => {
                const meta = elementTypes[element.type];
                const card = document.createElement('div');
                card.className = 'card mb-2 element-card';
                card.draggable = true;
                card.dataset.elementId = element.id;
                
                let valueInput = '';
                if (element.type === 'fixed') {
                    valueInput = `
                        <div class="col-md-6">
                            <input type="text" class="form-control form-control-sm" 
                                   value="${element.value || ''}" 
                                   placeholder="Enter text"
                                   onchange="updateElementValue(${element.id}, this.value)">
                        </div>`;
                } else if (element.type === 'datetime') {
                    valueInput = `
                        <div class="col-md-6">
                            <input type="text" class="form-control form-control-sm" 
                                   value="${element.value || 'yyyyMMdd'}" 
                                   placeholder="Format: yyyyMMdd"
                                   onchange="updateElementValue(${element.id}, this.value)">
                            <small class="text-muted">e.g., yyyyMMdd, yyyy-MM-dd</small>
                        </div>`;
                } else if (element.type === 'sequence') {
                    const opts = element.options ? JSON.parse(element.options) : { leadingZeros: 3 };
                    valueInput = `
                        <div class="col-md-6">
                            <label class="form-label form-label-sm">Leading Zeros</label>
                            <input type="number" class="form-control form-control-sm" 
                                   value="${opts.leadingZeros || 3}" 
                                   min="1" max="9"
                                   onchange="updateSequenceOptions(${element.id}, this.value)">
                        </div>`;
                }
                
                card.innerHTML = `
                    <div class="card-body p-2">
                        <div class="row align-items-center">
                            <div class="col-auto">
                                <i class="fas fa-grip-vertical text-muted" style="cursor: grab;"></i>
                            </div>
                            <div class="col-auto">
                                <span class="badge bg-${meta.color}">
                                    <i class="fas ${meta.icon} me-1"></i>${meta.name}
                                </span>
                            </div>
                            ${valueInput}
                            <div class="col-auto ms-auto">
                                <button type="button" class="btn btn-sm btn-outline-danger" 
                                        onclick="removeElement(${element.id})">
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                `;
                
                // Drag and drop handlers
                card.addEventListener('dragstart', handleDragStart);
                card.addEventListener('dragover', handleDragOver);
                card.addEventListener('drop', handleDrop);
                card.addEventListener('dragend', handleDragEnd);
                
                container.appendChild(card);
            });
        }

        // Update sequence options
        window.updateSequenceOptions = function(id, leadingZeros) {
            const element = idElements.find(e => e.id === id);
            if (element) {
                element.options = JSON.stringify({ leadingZeros: parseInt(leadingZeros) || 3 });
                updatePreview();
            }
        };

        window.updateElementValue = updateElementValue;
        window.removeElement = removeElement;

        // Drag and drop implementation
        let draggedElement = null;

        function handleDragStart(e) {
            draggedElement = this;
            this.style.opacity = '0.4';
            e.dataTransfer.effectAllowed = 'move';
        }

        function handleDragOver(e) {
            if (e.preventDefault) {
                e.preventDefault();
            }
            e.dataTransfer.dropEffect = 'move';
            return false;
        }

        function handleDrop(e) {
            if (e.stopPropagation) {
                e.stopPropagation();
            }

            if (draggedElement !== this) {
                const draggedId = parseInt(draggedElement.dataset.elementId);
                const targetId = parseInt(this.dataset.elementId);
                
                const draggedIdx = idElements.findIndex(e => e.id === draggedId);
                const targetIdx = idElements.findIndex(e => e.id === targetId);
                
                // Swap elements
                const temp = idElements[draggedIdx];
                idElements[draggedIdx] = idElements[targetIdx];
                idElements[targetIdx] = temp;
                
                // Update orders
                idElements.forEach((el, idx) => el.order = idx);
                
                renderElements();
                updatePreview();
            }
            return false;
        }

        function handleDragEnd(e) {
            this.style.opacity = '1';
            draggedElement = null;
        }

        // Update preview
        function updatePreview() {
            const separator = document.getElementById('separator').value || '-';
            if (idElements.length === 0) {
                document.getElementById('previewText').textContent = '-';
                return;
            }

            const parts = idElements
                .sort((a, b) => a.order - b.order)
                .map(element => {
                    const meta = elementTypes[element.type];
                    if (element.type === 'fixed') {
                        return element.value || 'TEXT';
                    } else if (element.type === 'datetime') {
                        // Show current date with format
                        const now = new Date();
                        const format = element.value || 'yyyyMMdd';
                        // Simple preview - just show the format or actual date
                        if (format === 'yyyyMMdd') return now.toISOString().slice(0,10).replace(/-/g, '');
                        if (format === 'yyyy-MM-dd') return now.toISOString().slice(0,10);
                        return format;
                    }
                    return meta.preview;
                });
            
            document.getElementById('previewText').textContent = parts.join(separator);
        }

        // Initialize preview
        updatePreview();
    </script>
    <style>
        .sortable-container {
            min-height: 100px;
        }
        .element-card {
            cursor: move;
            transition: all 0.2s;
        }
        .element-card:hover {
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }
        .element-card.dragging {
            opacity: 0.4;
        }
    </style>
}

@functions {
    private string GetFieldTypeIcon(string type)
    {
        return type switch
        {
            "string" => "fa-font",
            "text" => "fa-align-left",
            "number" => "fa-hashtag",
            "bool" => "fa-toggle-on",
            "file" => "fa-file",
            _ => "fa-question"
        };
    }

    private string GetFieldTypeDisplayName(string type)
    {
        return type switch
        {
            "string" => "Single-line Text",
            "text" => "Multi-line Text",
            "number" => "Number",
            "bool" => "True/False",
            "file" => "File/Image URL",
            _ => type
        };
    }

    private int GetFieldIndex(string type, int index)
    {
        return type switch
        {
            "string" => index - 1,
            "text" => index + 2,
            "number" => index + 5,
            "bool" => index + 8,
            "file" => index + 11,
            _ => 0
        };
    }
}