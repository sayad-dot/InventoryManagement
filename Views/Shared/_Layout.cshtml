<!DOCTYPE html>
<html lang="@System.Threading.Thread.CurrentThread.CurrentCulture.Name" data-theme="@(Context.Request.Cookies["theme"] ?? "light")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Inventory Management</title>
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    
    <!-- EasyMDE Markdown Editor -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/easymde@2.18.0/dist/easymde.min.css">
    
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <strong>Inventory Manager</strong>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
<ul class="navbar-nav me-auto">
    <li class="nav-item">
        <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">@Localizer["Home"]</a>
    </li>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" id="inventoryDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="fas fa-boxes me-1"></i> @Localizer["MyInventories"]
            </a>
            <ul class="dropdown-menu" aria-labelledby="inventoryDropdown">
                <li><a class="dropdown-item" asp-controller="Inventory" asp-action="MyInventories">
                    <i class="fas fa-list me-2"></i>@Localizer["MyInventories"]
                </a></li>
                <li><a class="dropdown-item" asp-controller="Inventory" asp-action="Create">
                    <i class="fas fa-plus me-2"></i>@Localizer["CreateInventory"]
                </a></li>
                <li><hr class="dropdown-divider"></li>
                <li><h6 class="dropdown-header">@Localizer["ViewAll"]</h6></li>
                <!-- Future enhancement: Recent inventories could be listed here -->
            </ul>
        </li>
        @if (User.IsInRole("Admin"))
        {
            <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="fas fa-crown me-1"></i>@Localizer["Admin"]
                </a>
                <ul class="dropdown-menu" aria-labelledby="adminDropdown">
                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Index">
                        <i class="fas fa-users-cog me-2"></i>@Localizer["UserManagement"]
                    </a></li>
                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="SystemStats">
                        <i class="fas fa-chart-bar me-2"></i>@Localizer["SystemStatistics"]
                    </a></li>
                </ul>
            </li>
        }
    }
</ul>
                    
                    <!-- Search Form in Navbar -->
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <form class="d-flex me-3" method="get" asp-controller="Search" asp-action="Index" id="navbarSearchForm">
                            <div class="input-group input-group-sm position-relative search-container">
                                <input type="search" class="form-control search-input" placeholder="@Localizer["Search"]" 
                                       name="Query" id="navbarSearch" aria-label="@Localizer["Search"]" 
                                       style="min-width: 160px;">
                                <button class="btn search-btn" type="submit">
                                    <i class="fas fa-search"></i>
                                </button>
                                <div class="dropdown-menu w-100" id="quickSearchResults"></div>
                            </div>
                        </form>
                    }
                    
                    <ul class="navbar-nav">
                        <!-- Language Switcher -->
                        <li class="nav-item dropdown me-3">
                            <a class="nav-link dropdown-toggle" href="#" id="languageDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fas fa-globe me-1"></i>
                                <span class="language-text d-none d-md-inline">
                                    @(System.Threading.Thread.CurrentThread.CurrentCulture.Name == "es" ? "ES" : "EN")
                                </span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="languageDropdown">
                                <li><a class="dropdown-item" href="#" data-language="en">
                                    <i class="fas fa-flag-usa me-2"></i>English
                                </a></li>
                                <li><a class="dropdown-item" href="#" data-language="es">
                                    <i class="fas fa-flag me-2"></i>Español
                                </a></li>
                            </ul>
                        </li>
                        
                        <!-- Theme Toggle -->
                        <li class="nav-item me-3">
                            <button class="btn btn-outline-light btn-sm theme-toggle" id="themeToggle">
                                <i class="fas @(Context.Request.Cookies["theme"] == "dark" ? "fa-sun" : "fa-moon")"></i>
                                <span class="theme-text d-none d-lg-inline ms-1">
                                    @(Context.Request.Cookies["theme"] == "dark" ? Localizer["Light"] : Localizer["Dark"])
                                </span>
                            </button>
                        </li>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fas fa-user me-1"></i> @(User.Identity.Name ?? "User")
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdown">
                                    <li><a class="dropdown-item" asp-controller="Profile" asp-action="Index">@Localizer["Profile"]</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item">@Localizer["Logout"]</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">@Localizer["Login"]</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Register">@Localizer["Register"]</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="container mt-4">
        @RenderBody()
    </main>

    <footer class="border-top footer text-muted mt-5">
        <div class="container">
            <div class="row">
                <div class="col-md-6">
                    &copy; 2024 - Inventory Management
                </div>
                <div class="col-md-6 text-end">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a href="#" class="text-decoration-none me-3" id="supportTicketLink">
                            <i class="fas fa-life-ring me-1"></i>@Localizer["Support"]
                        </a>
                    }
                    <a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-decoration-none">@Localizer["Privacy"]</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Support Ticket Modal -->
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="modal fade" id="supportTicketModal" tabindex="-1" aria-labelledby="supportTicketModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="supportTicketModalLabel">
                            <i class="fas fa-life-ring me-2"></i>Create Support Ticket
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <form id="supportTicketForm">
                            @Html.AntiForgeryToken()
                            
                            <div class="mb-3">
                                <label for="ticketSummary" class="form-label">Issue Summary <span class="text-danger">*</span></label>
                                <textarea class="form-control" id="ticketSummary" name="summary" rows="4" 
                                          placeholder="Please describe your issue or question..." 
                                          required maxlength="500"></textarea>
                                <div class="form-text">
                                    <i class="fas fa-info-circle"></i> Be as specific as possible to help us assist you better.
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="ticketPriority" class="form-label">Priority <span class="text-danger">*</span></label>
                                <select class="form-select" id="ticketPriority" name="priority" required>
                                    <option value="">Select priority...</option>
                                    <option value="Low">Low - General question or minor issue</option>
                                    <option value="Average" selected>Average - Normal issue affecting work</option>
                                    <option value="High">High - Critical issue blocking work</option>
                                </select>
                            </div>

                            <input type="hidden" id="ticketInventoryTitle" name="inventoryTitle" />
                            <input type="hidden" id="ticketPageUrl" name="pageUrl" />

                            <div id="ticketContextInfo" class="alert alert-info small mb-3" style="display: none;">
                                <i class="fas fa-info-circle me-1"></i>
                                <strong>Context:</strong> <span id="contextDetails"></span>
                            </div>

                            <div id="ticketAlert" class="alert" style="display: none;"></div>
                        </form>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            <i class="fas fa-times me-1"></i>Cancel
                        </button>
                        <button type="button" class="btn btn-primary" id="submitTicketBtn">
                            <i class="fas fa-paper-plane me-1"></i>Submit Ticket
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Bootstrap & jQuery -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Font Awesome -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/js/all.min.js"></script>
    
    <!-- EasyMDE Markdown Editor & Marked.js for rendering -->
    <script src="https://cdn.jsdelivr.net/npm/easymde@2.18.0/dist/easymde.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/marked@11.1.1/marked.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/dompurify@3.0.6/dist/purify.min.js"></script>
    
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/themeManager.js" asp-append-version="true"></script>
    
    @await RenderSectionAsync("Scripts", required: false)

<script>
    // Quick search functionality
    document.addEventListener('DOMContentLoaded', function() {
        const navbarSearch = document.getElementById('navbarSearch');
        const quickSearchResults = document.getElementById('quickSearchResults');
        
        if (navbarSearch) {
            navbarSearch.addEventListener('input', function() {
                const query = this.value.trim();
                
                if (query.length < 2) {
                    quickSearchResults.innerHTML = '';
                    quickSearchResults.classList.remove('show');
                    return;
                }
                
                // Debounce search
                clearTimeout(navbarSearch.searchTimeout);
                navbarSearch.searchTimeout = setTimeout(() => {
                    performQuickSearch(query);
                }, 300);
            });
            
            // Hide results when clicking outside
            document.addEventListener('click', function(e) {
                if (!navbarSearch.contains(e.target) && !quickSearchResults.contains(e.target)) {
                    quickSearchResults.classList.remove('show');
                }
            });
        }
        
        function performQuickSearch(query) {
            fetch(`/Search/QuickSearch?query=${encodeURIComponent(query)}`)
                .then(response => response.json())
                .then(data => {
                    if (data.success && data.results.length > 0) {
                        showQuickSearchResults(data.results);
                    } else {
                        quickSearchResults.innerHTML = '<div class="dropdown-item text-muted">No results found</div>';
                        quickSearchResults.classList.add('show');
                    }
                })
                .catch(error => {
                    console.error('Quick search error:', error);
                    quickSearchResults.innerHTML = '<div class="dropdown-item text-danger">Search error</div>';
                    quickSearchResults.classList.add('show');
                });
        }
        
        function showQuickSearchResults(results) {
            quickSearchResults.innerHTML = '';
            
            results.forEach(result => {
                const resultItem = document.createElement('a');
                resultItem.className = 'dropdown-item';
                resultItem.href = result.url;
                resultItem.innerHTML = `
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="badge ${result.type === 'inventory' ? 'bg-primary' : 'bg-success'} me-2">
                                ${result.type === 'inventory' ? 'I' : 'Item'}
                            </span>
                            <strong>${result.title}</strong>
                        </div>
                        <small class="text-muted">${result.relevance.toFixed(1)}</small>
                    </div>
                    <small class="text-muted">${result.creatorName}</small>
                `;
                quickSearchResults.appendChild(resultItem);
            });
            
            // Add "View all results" link
            const viewAllLink = document.createElement('a');
            viewAllLink.className = 'dropdown-item text-center border-top';
            viewAllLink.href = `/Search/Index?Query=${encodeURIComponent(navbarSearch.value)}`;
            viewAllLink.innerHTML = '<small class="text-primary">View all results</small>';
            quickSearchResults.appendChild(viewAllLink);
            
            quickSearchResults.classList.add('show');
        }
    });
</script>

<style>
    #quickSearchResults {
        max-height: 300px;
        overflow-y: auto;
        margin-top: 5px;
        position: absolute !important;
        top: 100%;
        z-index: 1050;
    }
    .dropdown-item {
        white-space: normal;
        padding: 0.5rem 1rem;
    }
    .input-group.position-relative {
        position: relative;
    }
    
    /* Support Ticket Modal Styles */
    #supportTicketModal .modal-content {
        background-color: var(--card-bg);
        border-color: var(--border-color);
    }
    #supportTicketModal .modal-header {
        border-bottom-color: var(--border-color);
    }
    #supportTicketModal .modal-footer {
        border-top-color: var(--border-color);
    }
    #supportTicketModal .btn-close {
        filter: var(--bs-btn-close-filter, none);
    }
    [data-theme="dark"] #supportTicketModal .btn-close {
        filter: invert(1) grayscale(100%) brightness(200%);
    }
    #supportTicketLink {
        color: var(--text-secondary);
        transition: color 0.3s ease;
    }
    #supportTicketLink:hover {
        color: var(--primary-color);
    }
</style>

<script>
    // Support Ticket Modal Functionality
    document.addEventListener('DOMContentLoaded', function() {
        const supportTicketLink = document.getElementById('supportTicketLink');
        const supportTicketModal = document.getElementById('supportTicketModal');
        const submitTicketBtn = document.getElementById('submitTicketBtn');
        const supportTicketForm = document.getElementById('supportTicketForm');
        const ticketAlert = document.getElementById('ticketAlert');
        
        if (supportTicketLink && supportTicketModal) {
            const modal = new bootstrap.Modal(supportTicketModal);
            
            // Open modal when clicking support link
            supportTicketLink.addEventListener('click', function(e) {
                e.preventDefault();
                
                // Capture current page context
                const pageUrl = window.location.href;
                const pageTitle = document.title;
                
                // Try to extract inventory title if on inventory page
                let inventoryTitle = null;
                const inventoryNameElement = document.querySelector('h1, h2, .inventory-title');
                if (inventoryNameElement) {
                    inventoryTitle = inventoryNameElement.textContent.trim();
                }
                
                // Set hidden fields
                document.getElementById('ticketPageUrl').value = pageUrl;
                document.getElementById('ticketInventoryTitle').value = inventoryTitle || '';
                
                // Show context info if available
                const contextInfo = document.getElementById('ticketContextInfo');
                const contextDetails = document.getElementById('contextDetails');
                if (inventoryTitle) {
                    contextDetails.textContent = `Inventory: "${inventoryTitle}"`;
                    contextInfo.style.display = 'block';
                } else {
                    contextDetails.textContent = `Page: ${pageTitle}`;
                    contextInfo.style.display = 'block';
                }
                
                // Reset form
                supportTicketForm.reset();
                ticketAlert.style.display = 'none';
                document.getElementById('ticketPriority').value = 'Average';
                
                modal.show();
            });
            
            // Submit ticket
            submitTicketBtn.addEventListener('click', function() {
                if (!supportTicketForm.checkValidity()) {
                    supportTicketForm.reportValidity();
                    return;
                }
                
                const submitBtn = this;
                const originalText = submitBtn.innerHTML;
                
                // Show loading state
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Submitting...';
                ticketAlert.style.display = 'none';
                
                // Prepare form data
                const formData = new FormData(supportTicketForm);
                
                // Submit via AJAX
                fetch('/Support/CreateTicket', {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        // Show success message
                        ticketAlert.className = 'alert alert-success';
                        ticketAlert.innerHTML = `
                            <i class="fas fa-check-circle me-2"></i>
                            <strong>Success!</strong> ${data.message}
                            <br><small>Ticket ID: #${data.ticketId}</small>
                        `;
                        ticketAlert.style.display = 'block';
                        
                        // Reset form
                        supportTicketForm.reset();
                        
                        // Close modal after 2 seconds
                        setTimeout(() => {
                            modal.hide();
                            ticketAlert.style.display = 'none';
                        }, 2000);
                    } else {
                        // Show error message
                        ticketAlert.className = 'alert alert-danger';
                        ticketAlert.innerHTML = `
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            <strong>Error:</strong> ${data.message}
                        `;
                        ticketAlert.style.display = 'block';
                    }
                })
                .catch(error => {
                    console.error('Error submitting ticket:', error);
                    ticketAlert.className = 'alert alert-danger';
                    ticketAlert.innerHTML = `
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        <strong>Error:</strong> Failed to submit ticket. Please try again.
                    `;
                    ticketAlert.style.display = 'block';
                })
                .finally(() => {
                    // Restore button
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = originalText;
                });
            });
        }
    });
</script>

</body>
</html>